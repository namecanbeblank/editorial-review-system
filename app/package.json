{
  "name": "bofu-linter-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor app for the bofu-linter engine. Express API + disk store, Vite/React front end.",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "codemirror": "^6.0.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lang-markdown": "^6.3.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "@types/express": "^4.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0"
  }
}
